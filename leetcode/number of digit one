class Solution {
    public int countDigitOne(int n) {
        int count = 0;
        for (long i = 1; i <= n; i *= 10) {
            long divider = i * 10;
            // Full blocks of 10^i numbers containing 10^(i-1) ones
            count += (n / divider) * i;
            // Remaining partial block
            count += Math.min(Math.max(n % divider - i + 1, 0), i);
        }
        return count;
    }
}
