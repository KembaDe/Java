def shortestPalindrome(s: str) -> str:
    if not s:
        return s
    
    # Combine string with its reverse using a separator
    # This prevents overlap issues (e.g., "aaaaa")
    combined = s + "#" + s[::-1]
    
    # KMP Table (Partial Match Table)
    table = [0] * len(combined)
    for i in range(1, len(combined)):
        j = table[i - 1]
        while j > 0 and combined[i] != combined[j]:
            j = table[j - 1]
        if combined[i] == combined[j]:
            j += 1
        table[i] = j
    
    # The last value in the table is the length of the longest palindromic prefix
    longest_pal_prefix_len = table[-1]
    
    # Take the suffix that isn't part of the palindrome, reverse it, and prepend
    suffix_to_add = s[longest_pal_prefix_len:][::-1]
    return suffix_to_add + s
