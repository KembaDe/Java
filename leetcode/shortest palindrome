class Solution {
    public String shortestPalindrome(String s) {
        if (s == null || s.length() == 0) return s;

        // Create the combined string: original + # + reversed
        String rev = new StringBuilder(s).reverse().toString();
        String combined = s + "#" + rev;
        
        // Build KMP table (Prefix function)
        int[] table = new int[combined.length()];
        for (int i = 1; i < combined.length(); i++) {
            int j = table[i - 1];
            while (j > 0 && combined.charAt(i) != combined.charAt(j)) {
                j = table[j - 1];
            }
            if (combined.charAt(i) == combined.charAt(j)) {
                j++;
            }
            table[i] = j;
        }

        // The last value in the table is the length of the longest palindromic prefix
        int longestPalPrefixLen = table[combined.length() - 1];
        
        // Get the suffix that isn't part of the palindrome, reverse it, and prepend
        String suffixToAdd = s.substring(longestPalPrefixLen);
        String reversedSuffix = new StringBuilder(suffixToAdd).reverse().toString();
        
        return reversedSuffix + s;
    }
}
