class Solution {
    public int calculate(String s) {
        Stack<Integer> stack = new Stack<>();
        int result = 0;
        int number = 0;
        int sign = 1; // 1 for '+', -1 for '-'

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (Character.isDigit(c)) {
                number = 10 * number + (c - '0');
            } else if (c == '+') {
                result += sign * number;
                number = 0;
                sign = 1;
            } else if (c == '-') {
                result += sign * number;
                number = 0;
                sign = -1;
            } else if (c == '(') {
                // Push the result and the sign before the parenthesis onto the stack
                stack.push(result);
                stack.push(sign);
                // Reset for the new scope
                sign = 1;
                result = 0;
            } else if (c == ')') {
                result += sign * number;
                number = 0;
                // Pop the sign before the parenthesis and multiply
                result *= stack.pop();
                // Pop the result before the parenthesis and add
                result += stack.pop();
            }
        }
        
        if (number != 0) result += sign * number;
        return result;
    }
}
